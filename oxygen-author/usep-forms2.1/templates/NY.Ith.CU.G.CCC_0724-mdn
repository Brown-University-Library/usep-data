                        <msItem class="#funerary.epitaph #list">
                            <!-- short summary of the content of an inscription -->
                            <p>cast of anthemion with Athenian casualties</p>
                        </msItem>
                    </msContents>

                    <!--  *************************************  <physDesc>  ********************************* -->
                    <physDesc>
