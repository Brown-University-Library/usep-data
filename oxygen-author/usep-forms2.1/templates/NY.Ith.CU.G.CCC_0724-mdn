                                        <height>49</height>
                                        <width>139</width>
                                        <depth>7</depth>
                                    </dimensions>
                                </support>
                                <condition ana="#fragment.single">
                                    <p>cast of one of two fragments of the original inscription:
                                        only a small portion of the text is preserved in this, while
                                        the majority appears on the other fragment (the cast of
                                        which is NY.Ith.CU.G.CCC_427-mdn) </p>
                                </condition>
                            </supportDesc>
                            <!--  *************************************  <layoutDesc>  ********************************* -->
                            <layoutDesc>
